FEED_PASSWORD=your-password-here
# Bearer token the Mac Mini uses to POST /api/hoops/import (kad-air/keith-hub#73).
# Generate with `openssl rand -hex 32`. Dedicated token, NOT FEED_PASSWORD —
# different blast radius, and it must be rotatable without logging every
# device out of the hub. Unset in production = the route refuses every
# request (fail CLOSED — see app/api/hoops/import/route.ts).
HOOPS_IMPORT_TOKEN=your-hoops-import-token-here
# Device credential for the Books section's /opds/{key}/... and /kosync/{key}/...
# routes (BOOKS_PLAN.md §3) — key-in-URL because e-readers store one URL and
# cannot complete an auth challenge. Generate with `openssl rand -hex 32`.
# Same conventions as HOOPS_IMPORT_TOKEN: dedicated (never FEED_PASSWORD),
# rotatable per-device-class, and FAIL CLOSED when unset (see lib/books/apiKey.ts).
BOOKS_API_KEY=your-books-api-key-here
# Adobe account RSA private key (PKCS#8 DER, base64) used to strip ADEPT DRM
# from an uploaded epub — see lib/books/adept.ts. Unset = DRM'ed uploads are
# REFUSED with a reason, never ingested broken (fail CLOSED, same convention
# as the two above). Optional: a DRM-free library needs nothing here.
# 🔴 Becomes mostly vestigial once .acsm fulfilment lands — the hub will mint
# its own anonymous Adobe activation and store it in the kv table, leaving
# this as an override for a key fulfilled elsewhere.
ADOBE_ADEPT_KEY=
# Adobe ADEPT activation, base64-encoded JSON (or raw JSON). Lets the hub
# fulfil an uploaded .acsm into the book it names, so uploading a .acsm is the
# same gesture as uploading an .epub. Anonymous Adobe account — no personal
# credentials, nothing to log into. Provisioned ONCE out of band (see the Books
# "ACSM fulfilment" section of CLAUDE.md); registering an account needs PKCS#12
# parsing that Node has no native support for, so it is deliberately not done
# here. Unset = .acsm uploads are refused with a reason; .epub uploads are
# unaffected. 🔴 Contains the licence key that decrypts books fulfilled by this
# activation, and it WINS over ADOBE_ADEPT_KEY above (a book is encrypted to
# the activation that fulfilled it).
ADOBE_ADEPT_ACTIVATION=
BLUESKY_IDENTIFIER=your.handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password
CRAFT_API_KEY=your-craft-api-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
